<mxfile host="app.diagrams.net" modified="2026-11-02T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="oep-class" name="OEP Class Diagram"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="ONLINE EXAMINATION PORTAL — UML CLASS DIAGRAM&#xa;Model contract: Exam, Question, Attempt, AttemptAnswer; Result from evaluation integration PR #24" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1200" height="60" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;&lt;Django AUTH_USER_MODEL&gt;&gt;&#xa;User&#xa;--------------------&#xa;+ id : PK&#xa;+ username : CharField&#xa;+ email : EmailField&#xa;+ is_staff : BooleanField" style="swimlane;html=1;startSize=28;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="280" height="180" as="geometry"/></mxCell>
<mxCell id="exam" value="&lt;&lt;model&gt;&gt;&#xa;Exam&#xa;--------------------&#xa;+ id : BigAutoField PK&#xa;+ title : CharField(200)&#xa;+ description : TextField&#xa;+ duration_minutes : PositiveInteger&#xa;+ start_time : DateTime&#xa;+ end_time : DateTime&#xa;+ is_active : Boolean&#xa;+ pass_percentage : Decimal(5,2)&#xa;+ created_at : DateTime&#xa;--------------------&#xa;+ created_by : FK(User)&#xa;+ clean()" style="swimlane;html=1;startSize=28;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="350" height="330" as="geometry"/></mxCell>
<mxCell id="question" value="&lt;&lt;model&gt;&gt;&#xa;Question&#xa;--------------------&#xa;+ id : BigAutoField PK&#xa;+ text : TextField&#xa;+ option_a : CharField(500)&#xa;+ option_b : CharField(500)&#xa;+ option_c : CharField(500)&#xa;+ option_d : CharField(500)&#xa;+ correct_option : CharField(1), A-D&#xa;+ marks : PositiveInteger&#xa;+ created_at : DateTime&#xa;--------------------&#xa;+ exam : FK(Exam)&#xa;+ options : property" style="swimlane;html=1;startSize=28;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="370" height="320" as="geometry"/></mxCell>
<mxCell id="attempt" value="&lt;&lt;model&gt;&gt;&#xa;Attempt&#xa;--------------------&#xa;+ id : BigAutoField PK&#xa;+ started_at : DateTime&#xa;+ deadline_at : DateTime&#xa;+ submitted_at : DateTime?&#xa;+ status : IN_PROGRESS | SUBMITTED | AUTO_SUBMITTED&#xa;--------------------&#xa;+ student : FK(User)&#xa;+ exam : FK(Exam)&#xa;Unique(student, exam)" style="swimlane;html=1;startSize=28;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="570" width="350" height="250" as="geometry"/></mxCell>
<mxCell id="answer" value="&lt;&lt;model&gt;&gt;&#xa;AttemptAnswer&#xa;--------------------&#xa;+ id : BigAutoField PK&#xa;+ selected_option : CharField(1), A-D&#xa;+ updated_at : DateTime&#xa;--------------------&#xa;+ attempt : FK(Attempt)&#xa;+ question : FK(Question)&#xa;Unique(attempt, question)" style="swimlane;html=1;startSize=28;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980" y="580" width="370" height="220" as="geometry"/></mxCell>
<mxCell id="result" value="&lt;&lt;model&gt;&gt;&#xa;Result&#xa;--------------------&#xa;+ id : BigAutoField PK&#xa;+ score : PositiveInteger&#xa;+ total_marks : PositiveInteger&#xa;+ percentage : Decimal(6,2)&#xa;+ passed : Boolean&#xa;+ created_at : DateTime&#xa;+ updated_at : DateTime&#xa;--------------------&#xa;+ attempt : OneToOneField(Attempt)&#xa;+ student : FK(User)&#xa;+ exam : FK(Exam)" style="swimlane;html=1;startSize=28;horizontal=1;rounded=0;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="300" height="260" as="geometry"/></mxCell>
<mxCell id="u_exam" value="creates (1 to 0..*)" style="endArrow=none;startArrow=none;html=1;" edge="1" parent="1" source="user" target="exam"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u_attempt" value="student (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="user" target="attempt"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="u_result" value="student (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="user" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="exam_q" value="contains (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="exam" target="question"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="exam_a" value="has attempts (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="exam" target="attempt"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="exam_r" value="has results (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="exam" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="attempt_ans" value="answers (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="attempt" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="question_ans" value="answered question (1 to 0..*)" style="endArrow=none;html=1;" edge="1" parent="1" source="question" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="attempt_result" value="evaluated as (1 to 0..1) — OneToOne" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="attempt" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="notes" value="Constraints: one Attempt per (student, exam); one AttemptAnswer per (attempt, question); Result has OneToOne Attempt; Exam.pass_percentage validated 0–100; Question.correct_option and AttemptAnswer.selected_option restricted to A–D.&#xa;Schema note: Result, Exam.pass_percentage and Question.marks are part of the merged main-branch model (PR #24). Result is persisted one-to-one with a submitted Attempt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="420" y="900" width="950" height="100" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>