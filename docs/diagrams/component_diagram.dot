digraph OEPComponents {
  graph [rankdir=TB, splines=ortho, fontname="Arial", label="ONLINE EXAMINATION PORTAL — COMPONENT DIAGRAM", labelloc=t];
  node [shape=box, style="rounded", fontname="Arial"];
  Browser [label="Student / Admin Browser"];
  subgraph cluster_django {
    label="Django Web Application (modular monolith)";
    UI [label="Templates and Static UI"];
    Accounts [label="Accounts — IIdentitySession"];
    Exams [label="Exams — IExamAdministration"];
    Questions [label="Questions — IQuestionManagement"];
    Attempts [label="Attempts — IAttemptLifecycle"];
    Results [label="Results — IResultPresentation"];
    Auth [shape=cylinder,label="Django Auth and Sessions"];
    DB [shape=cylinder,label="Relational Database: Exam, Question, Attempt, AttemptAnswer, Result"];
  }
  Browser -> UI [label="HTTPS / HTML / JSON"];
  UI -> Accounts; UI -> Exams; UI -> Questions; UI -> Attempts; UI -> Results;
  Accounts -> Auth [label="identity"];
  Exams -> Auth [label="identity"];
  Questions -> Accounts [label="admin authorization"];
  Attempts -> Auth [label="identity"];
  Attempts -> Questions [label="question lookup"];
  Attempts -> Results [label="submit for evaluation"];
  Exams -> DB [label="exam persistence"];
  Questions -> DB [label="question persistence"];
  Attempts -> DB [label="attempt / answer persistence"];
  Results -> DB [label="result persistence"];
}